# Port published on the host (container always listens on 3000)
PORT=3000

# Optional password gate. Leave empty to disable the login screen.
# On anything reachable from the internet, set this.
APP_PASSWORD=

# Secret used to sign the session cookie. Any long random string.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Where the SQLite database and backups live inside the container.
# docker-compose bind-mounts ./data here, so this normally stays as is.
DATA_DIR=/data

# How many daily backups to keep (oldest are pruned)
BACKUP_KEEP=14

# Hour of day (Asia/Manila, 0-23) to run the automatic daily backup
BACKUP_HOUR=3

TZ=Asia/Manila

# --- AI (receipt parsing + Ask) ---
# Any OpenAI-compatible chat API; defaults to DeepSeek. Leave AI_API_KEY empty to hide both AI features.
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-v4-pro
# true only for a model that reads images; it shows the attach button on Ask
AI_IMAGES=false
# Optional, given to the Ask advisor: your name and a line about you (work, city, what you're saving for)
OWNER_NAME=
OWNER_ABOUT=
# Secret path segment for the MCP endpoint (/api/mcp/<token>) your own AI client can call. Generate with: openssl rand -hex 24
MCP_TOKEN=

# Read-only bearer token for /api/bills/upcoming (menu bar app). Generate with: openssl rand -hex 24
API_TOKEN=
